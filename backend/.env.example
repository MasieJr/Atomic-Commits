PORT=3000
NODE_ENV=development
# JWT signing secret for the API - at least 32 random characters, server-only
JWT_SECRET=
DATABASE_URL=
# AES-256-GCM key for secrets at rest (TOTP seeds, provider tokens): 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must NOT be the JWT secret. Losing it makes stored device secrets unreadable.
DATA_ENCRYPTION_KEY=
# Public base URL of this API (no trailing slash). The Test Wallet redirects the payer's
# browser to $PUBLIC_BASE_URL/api/open-payments/callback/<id> after approval.
# Local testing: http://localhost:3000   EC2: https://<your-domain-or-ip>
PUBLIC_BASE_URL=

# Open Payments - server-only developer client configuration
CLIENT_WALLET_ADDRESS_URL=
KEY_ID=
PRIVATE_KEY_PATH=.env.open-payments.key

# TEMPORARY two-wallet lookup inputs for the integration
# Flutter onboarding will use verified per-user wallet links via the API
SENDING_WALLET_ADDRESS_URL=
RECEIVING_WALLET_ADDRESS_URL=

# TEMPORARY Test Wallet proofs - minor units of recipient/payer assets respectively
PAYMENT_PROOF_RECEIVE_AMOUNT_MINOR=10
PAYMENT_PROOF_BUDGET_MINOR=500
PAYMENT_PROOF_CALLBACK_PORT=3999
PAYMENT_PROOF_CONSENT_TIMEOUT_SECONDS=600
PAYMENT_PROOF_SETTLEMENT_TIMEOUT_SECONDS=90
