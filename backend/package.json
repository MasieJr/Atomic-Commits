{
  "name": "atomic-commits-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run build && node dist/migrate.js",
    "wallet:lookup": "npm run build && node dist/src/commands/wallet-lookup.js",
    "payment:proof-a": "npm run build && node dist/src/commands/payment-proof.js a",
    "payment:proof-b": "npm run build && node dist/src/commands/payment-proof.js b",
    "payment:proofs": "npm run build && node dist/src/commands/payment-proof.js both"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@interledger/open-payments": "^7.4.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
