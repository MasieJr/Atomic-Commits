%% Current integration structure. Live end-to-end verification is tracked separately.
flowchart LR
    A["User A Flutter app<br/>secure session and TOTP profile"]
    B["User B Flutter app<br/>merchant checkout"]
    Browser["Provider browser<br/>owner authentication and consent"]
    API["Atomic Commits API<br/>JWT authentication"]
    Wallet["Wallet verification<br/>subject grant and callback"]
    Grant["Spending grants<br/>approval, limits and token rotation"]
    Redeem["Redemption service<br/>code claims, reservations and reconciliation"]
    DB[("Supabase<br/>users, verified wallets, grants,<br/>devices and payment attempts")]
    SDK["Open Payments SDK<br/>backend signing identity"]
    Provider["Interledger Test Wallet<br/>authorization and payment resources"]

    A -->|"register, link, authorize, enroll"| API
    B -->|"register, link, activate merchant, redeem"| API
    API --> Wallet
    API --> Grant
    API --> Redeem
    Wallet <--> DB
    Grant <--> DB
    Redeem <--> DB
    Wallet --> SDK
    Grant --> SDK
    Redeem --> SDK
    SDK <--> Provider
    A -->|"open provider interaction"| Browser
    B -->|"open provider interaction"| Browser
    Browser --> Provider
    Provider -->|"verified callback"| API
    A -. "offline code or QR" .-> B
    Redeem -->|"confirmed receipt or unresolved status"| B
